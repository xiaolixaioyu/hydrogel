.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0;
}

.header {
  background-color: rgba(255, 255, 255, 0.95);
  padding: 40rpx 30rpx;
  text-align: center;
  border-radius: 0 0 60rpx 60rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
}

.content {
  padding: 40rpx 30rpx;
  flex: 1;
}

.image-section {
  margin-bottom: 40rpx;
}

.image-container {
  background-color: #fff;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
  min-height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-image {
  width: 100%;
  height: 500rpx;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.placeholder-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.placeholder-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.placeholder-hint {
  font-size: 24rpx;
  color: #999;
}

.result-section {
  background-color: #fff;
  border-radius: 30rpx;
  padding: 50rpx 30rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.15);
}

.temperature-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 30rpx;
}

.temperature-value {
  font-size: 120rpx;
  font-weight: bold;
  color: #333;
}

.temperature-unit {
  font-size: 48rpx;
  color: #666;
  margin-left: 10rpx;
}

.status-badge {
  display: inline-block;
  padding: 15rpx 50rpx;
  border-radius: 50rpx;
  margin-bottom: 20rpx;
}

.status-badge.status-normal {
  background-color: #2ecc71;
}

.status-badge.status-mild {
  background-color: #f1c40f;
}

.status-badge.status-high {
  background-color: #e74c3c;
}

.status-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.status-message {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.button-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn {
  border-radius: 50rpx;
  font-size: 32rpx;
  padding: 25rpx 0;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.2);
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-secondary {
  background-color: #fff;
  color: #667eea;
}

.btn[disabled] {
  opacity: 0.6;
}

.info-section {
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 30rpx;
}

.info-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.6;
}
